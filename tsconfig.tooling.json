{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": ".tsbuild/tooling",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.d.mts",
    "playwright.config.ts",
    "playwright/e2e/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", ".tsbuild"]
}
