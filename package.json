{
  "name": "speakerops",
  "private": true,
  "version": "0.1.0",
  "description": "SpeakerOps Program OS — section-runner workspace",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/ && vitest run",
    "test:ci": "node --test tests/ && vitest run",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:e2e:inventory": "tsx scripts/inventory-lint.ts",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "seed": "tsx scripts/seed.ts",
    "deploy:dogfood": "bash scripts/deploy-dogfood.sh",
    "docs:reports": "node scripts/docs-reports-stub.mjs",
    "docs:e2e-report": "tsx scripts/build-e2e-report.ts",
    "audit:deps": "node scripts/dependency-audit.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "sql.js": "^1.14.1",
    "tsx": "^4.23.11",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "wrangler": "^3.112.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.7.0"
}
