{
  "version": 1,
  "section": "8.1",
  "description": "Admin primary-action discovery crawl allowlist (S-E2E-INV). Pure chrome is exempt; every other primary control must map to a REQUIRED inventory ID via data-inv or controlMap. Document reasons — bare wildcards forbidden.",
  "docs": [
    "docs/governance/0.3-e2e-inventory-law.md §6 Discovery crawl",
    "docs/sections/8.1-inventory-completeness.md",
    "KMS-competition/initiative/BROWSER_E2E_INVENTORY.md"
  ],
  "primaryRules": {
    "elements": ["button", "input[type=submit]", "[role=button]"],
    "requireTestIdOrInv": true,
    "notes": "Primary = interactive action control (button/submit/role=button). Decorative chrome and non-action anchors use chrome[] or are non-primary tags (div/span/nav)."
  },
  "chrome": [
    {
      "testid": "admin-shell",
      "reason": "Layout root chrome — not an action"
    },
    {
      "testid": "admin-sidebar",
      "reason": "Sidebar container chrome"
    },
    {
      "testid": "admin-nav",
      "reason": "Nav landmark chrome; leaf links mapped separately if primary"
    },
    {
      "testid": "admin-page-title",
      "reason": "Heading chrome"
    },
    {
      "testid": "admin-content",
      "reason": "Main content landmark"
    },
    {
      "testid": "admin-active-event",
      "reason": "Hidden event label chrome"
    },
    {
      "testid": "design-preview-button",
      "reason": "Decorative brand preview sample — not a product action"
    },
    {
      "testid": "form-actions",
      "reason": "Action group container, not a control"
    },
    {
      "testid": "speakers-pager",
      "reason": "Pager chrome container; next/prev leaf controls mapped"
    },
    {
      "testid": "submissions-pager",
      "reason": "Submissions list pager chrome container (10.1); next/prev leaf controls mapped to E01"
    },
    {
      "testid": "api-key-prefix-value",
      "reason": "Read-only prefix display (K03 proof surface), not a primary action button"
    },
    {
      "testid": "schedule-list-session-*",
      "reason": "List label affordance for placed session identity; place/move actions use tray/slot controls (I06/I13)"
    }
  ],
