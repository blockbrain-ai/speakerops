{
  "version": 1,
  "section": "8.1",
  "description": "Admin primary-action discovery crawl allowlist (S-E2E-INV). Pure chrome is exempt; every other primary control must map to a REQUIRED inventory ID via data-inv or controlMap. Document reasons \u2014 bare wildcards forbidden.",
  "docs": [
    "docs/governance/0.3-e2e-inventory-law.md \u00a76 Discovery crawl",
    "docs/sections/8.1-inventory-completeness.md",
    "KMS-competition/initiative/BROWSER_E2E_INVENTORY.md"
  ],
  "primaryRules": {
    "elements": [
      "button",
      "input[type=submit]",
      "[role=button]"
    ],
    "requireTestIdOrInv": true,
    "notes": "Primary = interactive action control (button/submit/role=button). Decorative chrome and non-action anchors use chrome[] or are non-primary tags (div/span/nav)."
