{
  "name": "@speakerops/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "First-party TypeScript client for the SpeakerOps HTTP API. Not published to public npm.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b",
    "test": "vitest run src"
  },
  "dependencies": {
    "@speakerops/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
